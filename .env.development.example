# Local-only setup: copy to `.env.local`, which Next.js loads ahead of `.env`.
#
# Everything here points at the Firebase emulator suite under the project id `demo-acpt`. The
# `demo-` prefix is load-bearing: the Firebase SDKs refuse to contact any real cloud service for a
# demo project, so this configuration physically cannot reach production.
#
# Start the emulators in a second terminal (needs JDK 21+ and firebase-tools):
#   yarn emulators
#
# See docs/ENVIRONMENTS.md.

NEXT_PUBLIC_URL=http://localhost:3060

NEXTAUTH_URL=http://localhost:3060
# Generate your own: openssl rand -base64 32
NEXTAUTH_SECRET=

NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-acpt.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-acpt
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-acpt.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=0
NEXT_PUBLIC_FIREBASE_APP_ID=1:0:web:0

NEXT_PUBLIC_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Functions emulator, same project id.
NEXT_PUBLIC_UPDATE_USER=http://127.0.0.1:5001/demo-acpt/us-central1/updateUser
NEXT_PUBLIC_GET_CERTIFICATE=http://127.0.0.1:5001/demo-acpt/us-central1/getCertificateData
NEXT_PUBLIC_GET_CERTIFICATE_BY_ID=http://127.0.0.1:5001/demo-acpt/us-central1/getCertificateDataById
NEXT_PUBLIC_PROCESS_PAYMENT=http://127.0.0.1:5001/demo-acpt/us-central1/processPayment
NEXT_PUBLIC_REFUND_PAYMENT=http://127.0.0.1:5001/demo-acpt/us-central1/refundPayment
NEXT_PUBLIC_SEND_FRONT_MAIL_URL=http://127.0.0.1:5001/demo-acpt/us-central1/sendFrontEndMail
NEXT_PUBLIC_UPDATE_USER_ANALYTICS=http://127.0.0.1:5001/demo-acpt/us-central1/updateRegistrationsAnalytics

# Stripe test mode. processPayment additionally needs the STRIPE_API_KEY secret, which the
# emulator reads from functions/.secret.local (git-ignored) — see docs/ENVIRONMENTS.md.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
