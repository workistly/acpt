# Copy to `.env` and fill in. Values come from the team password manager — never Slack or email.
# `.env` is git-ignored and must stay that way.
#
# For a local-only setup that never touches production, see .env.development.example
# and docs/ENVIRONMENTS.md.

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_URL=http://localhost:3060

# --- NextAuth ----------------------------------------------------------------
# Both are required; the app will not start without them.
# NEXTAUTH_SECRET: generate your own with `openssl rand -base64 32`.
NEXTAUTH_URL=http://localhost:3060
NEXTAUTH_SECRET=

# --- Firebase (client SDK, safe to expose to the browser) --------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to point Firestore and Auth at the local emulator suite.
NEXT_PUBLIC_FIREBASE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# --- Cloud Functions endpoints ------------------------------------------------
# Full https URLs of the deployed functions (see functions/src/index.ts).
NEXT_PUBLIC_UPDATE_USER=
NEXT_PUBLIC_GET_CERTIFICATE=
NEXT_PUBLIC_GET_CERTIFICATE_BY_ID=
NEXT_PUBLIC_PROCESS_PAYMENT=
NEXT_PUBLIC_REFUND_PAYMENT=
NEXT_PUBLIC_SEND_FRONT_MAIL_URL=
NEXT_PUBLIC_UPDATE_USER_ANALYTICS=

# --- Stripe -------------------------------------------------------------------
# Test-mode publishable key only. The secret key lives in Secret Manager, not here.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
