{
  "name": "acpt",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "lingui compile && next dev -p 3060 --turbopack",
    "build": "lingui compile && next build",
    "start": "next start",
    "emulators": "npm --prefix functions run build && firebase emulators:start --only firestore,auth,functions --project demo-acpt",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "upgrade": "ncu -u && yarn",
    "extract": "lingui extract --clean",
    "compile": "lingui compile",
    "prepare": "husky"
  },
  "dependencies": {
    "@lingui/cli": "^5.3.2",
    "@lingui/core": "^5.3.2",
    "@lingui/react": "^5.3.2",
    "@lingui/swc-plugin": "5.5.2",
    "@mantine/core": "^8.0.2",
    "@mantine/dates": "^8.0.2",
    "@mantine/form": "^8.0.2",
    "@mantine/hooks": "^8.0.2",
    "@mantine/modals": "^8.0.2",
    "@mantine/notifications": "^8.0.2",
    "@stripe/react-stripe-js": "^3.7.0",
    "@stripe/stripe-js": "^7.3.1",
    "@tabler/icons-react": "^3.33.0",
    "@tanstack/react-query": "^5.79.0",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.4.9",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "firebase": "^11.8.1",
    "framer-motion": "^12.15.0",
    "lodash": "^4.17.21",
    "next": "~15.5.24",
    "next-auth": "^4.24.11",
    "nookies": "^2.5.2",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.0",
    "react-timer-hook": "^4.0.5",
    "react-webcam": "^7.2.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16",
    "@types/bcryptjs": "^3.0.0",
    "@types/lodash": "^4.17.17",
    "@types/node": "^22.15.24",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-config-next": "~15.5.24",
    "eslint-plugin-lingui": "^0.10.1",
    "husky": "^9.1.7",
    "jsdom": "^26",
    "lint-staged": "^16.1.0",
    "postcss": "^8.5.4",
    "postcss-import": "^16.1.0",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.5.3",
    "tailwind-preset-mantine": "^2.1.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^7",
    "vitest": "^3"
  }
